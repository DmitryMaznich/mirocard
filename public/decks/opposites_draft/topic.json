{
  "meta": {
    "id": "opposites",
    "version": "2.12.0",
    "renderer": "opposites",
    "title": "Противоположности",
    "avatar": "media/avatar.svg",
    "conceptCount": 9
  },
  "modes": [
    {
      "id": "intro",
      "type": "intro",
      "evaluation": "none",
      "ui": {
        "title": "Знакомство",
        "instruction": "Смотрим на карточки",
        "icon": "media/icons/intro.svg"
      }
    },
    {
      "id": "pair_comparison",
      "type": "pair_comparison",
      "evaluation": "none",
      "ui": {
        "title": "Сравниваем",
        "instruction": "Посмотри на оба",
        "icon": "media/icons/pair_comparison.svg"
      },
      "params": {
        "showLabels": {
          "type": "boolean",
          "default": true,
          "label": {
            "ru": "Подписи к карточкам"
          },
          "hint": {
            "ru": "Выключи для лайт-режима — только картинки"
          }
        }
      }
    },
    {
      "id": "choose_two",
      "type": "choose_two",
      "evaluation": "auto",
      "ui": {
        "title": "Покажи",
        "instruction": "Найди нужную карточку",
        "icon": "media/icons/choose_two.svg"
      },
      "params": {
        "repsPerPair": {
          "type": "enum",
          "values": [
            1,
            2
          ],
          "default": 2,
          "label": {
            "ru": "Повторений на пару"
          },
          "hint": {
            "ru": "1 — спросить один полюс, 2 — оба"
          }
        }
      }
    },
    {
      "id": "sort",
      "type": "sort",
      "evaluation": "auto",
      "ui": {
        "title": "Сортировка",
        "instruction": "Перетащи в нужную группу",
        "icon": "media/icons/sort.svg"
      },
      "params": {
        "cardCount": {
          "type": "enum",
          "values": [
            4,
            6,
            8
          ],
          "default": 4,
          "label": {
            "ru": "Карточек"
          }
        }
      }
    },
    {
      "id": "find_all",
      "type": "find_all",
      "evaluation": "auto",
      "ui": {
        "title": "Найди все",
        "instruction": "Отметь все подходящие",
        "icon": "media/icons/find_all.svg"
      },
      "params": {
        "gridSize": {
          "type": "enum",
          "values": [
            4,
            6
          ],
          "default": 6,
          "label": {
            "ru": "Карточек в сетке"
          }
        }
      }
    },
    {
      "id": "find_opposite",
      "type": "find_opposite",
      "evaluation": "auto",
      "ui": {
        "title": "Найди пару",
        "instruction": "Найди противоположность и перетащи её сюда",
        "icon": "media/icons/find_opposite.svg"
      },
      "params": {
        "distractorCount": {
          "type": "enum",
          "values": [
            2,
            4,
            6
          ],
          "default": 2,
          "label": {
            "ru": "Дистракторов"
          },
          "hint": {
            "ru": "2 — легко, 6 — сложно"
          }
        },
        "sameConcept": {
          "type": "boolean",
          "default": false,
          "label": {
            "ru": "Дистракторы из той же пары понятий"
          },
          "hint": {
            "ru": "Включи для максимальной сложности"
          }
        },
        "stimulusType": {
          "type": "enum",
          "values": [
            "image",
            "text"
          ],
          "default": "image",
          "label": {
            "ru": "Стимул"
          },
          "hint": {
            "ru": "Картинка — найди противоположную картинку; Слово — найди картинку-антоним"
          }
        },
        "distractorType": {
          "type": "enum",
          "values": [
            "image",
            "text"
          ],
          "default": "image",
          "label": {
            "ru": "Дистракторы"
          },
          "hint": {
            "ru": "Картинки или слова"
          }
        }
      }
    }
  ],
