{
  "meta": {
    "id": "opposites",
    "version": "1.0.0",
    "renderer": "opposites",
    "title": "Противоположности",
    "avatar": "media/avatar.webp"
  },
  "modes": [
    {
      "id": "intro",
      "type": "intro",
      "evaluation": "none",
      "ui": {
        "title": "Знакомство",
        "instruction": "Смотрим на карточки"
      }
    },
    {
      "id": "pair_comparison",
      "type": "pair_comparison",
      "evaluation": "none",
      "ui": {
        "title": "Сравниваем",
        "instruction": "Посмотри на оба"
      }
    },
    {
      "id": "choose_two",
      "type": "choose_two",
      "evaluation": "auto",
      "ui": {
        "title": "Покажи",
        "instruction": "Найди нужную карточку"
      },
      "params": {
        "optionCount": {
          "type": "enum",
          "values": [2, 4],
          "default": 2,
          "label": { "ru": "Вариантов" }
        },
        "repsPerPair": {
          "type": "number",
          "default": 2,
          "min": 1,
          "max": 4,
          "label": { "ru": "Повторений на пару" }
        },
        "mixPairs": {
          "type": "boolean",
          "default": false,
          "label": { "ru": "Дистракторы из других пар" }
        }
      }
    },
    {
      "id": "sort",
      "type": "sort",
      "evaluation": "auto",
      "ui": {
        "title": "Сортировка",
        "instruction": "Перетащи в нужную группу"
      },
      "params": {
        "cardCount": {
          "type": "enum",
          "values": [4, 6, 8],
          "default": 4,
          "label": { "ru": "Карточек" }
        }
      }
    },
    {
      "id": "find_all",
      "type": "find_all",
      "evaluation": "auto",
      "ui": {
        "title": "Найди все",
        "instruction": "Отметь все подходящие"
      },
      "params": {
        "gridSize": {
          "type": "enum",
          "values": [4, 6],
          "default": 6,
          "label": { "ru": "Карточек в сетке" }
        }
      }
    }
  ],
