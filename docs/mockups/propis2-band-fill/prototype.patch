diff --git a/src/features/propis2/Propis2FillPicker.jsx b/src/features/propis2/Propis2FillPicker.jsx
new file mode 100644
index 0000000..f19b948
--- /dev/null
+++ b/src/features/propis2/Propis2FillPicker.jsx
@@ -0,0 +1,60 @@
+import { useEffect, useRef, useState } from "react";
+import { useHint } from "./Propis2Hint";
+import { usePopupPos } from "./usePopupPos";
+import { BAND_FILLS } from "@/topics/renderers/propis2/model.js";
+import { IconBandFill, IconFillAll, IconFillWrite } from "./Propis2Icons";
+
+// «Заливка» (prototype): one button showing the current tint; its popup: a row of swatches, then where the band is tinted.
+const Caret = () => (
+  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M2 3.5l3 3 3-3" /></svg>
+);
+const WHERE = [
+  { id: "write", label: "Строки для письма", Icon: IconFillWrite },
+  { id: "all", label: "Все строки", Icon: IconFillAll },
+];
+
+export default function Propis2FillPicker({ value, onChange, disabled = false, startOpen = false }) {
+  const [openRaw, setOpen] = useState(startOpen);
+  const open = openRaw && !disabled;
+  const ref = useRef(null);
+  const btnRef = useRef(null);
+  const listStyle = usePopupPos(open, btnRef, 212, () => setOpen(false));
+  const fill = BAND_FILLS.find((f) => f.id === value?.id) ?? BAND_FILLS[0];
+  const where = value?.where === "all" ? "all" : "write";
+  useEffect(() => {
+    if (!open) return undefined;
+    const away = (e) => { if (!ref.current?.contains(e.target)) setOpen(false); };
+    document.addEventListener("pointerdown", away);
+    return () => document.removeEventListener("pointerdown", away);
+  }, [open]);
+  const { bind, tip } = useHint("Заливка узкой строки");
+  return (
+    <div className="p2-pick" ref={ref}>
+      <button type="button" ref={btnRef} className={`p2-pick-btn p2-tool${open ? " is-open" : ""}`} aria-label="Заливка узкой строки" aria-haspopup="dialog" aria-expanded={open} disabled={disabled} onClick={() => setOpen((o) => !o)} {...bind}>
+        <span className="p2-tool-ico"><IconBandFill color={fill.color} /><Caret /></span>
+        <span className="p2-cap">Заливка</span>
+        {tip}
+      </button>
+      {open && (
+        <div className="p2-pick-list p2-fill-pop" role="dialog" aria-label="Заливка узкой строки" style={listStyle ?? undefined}>
+          <div className="p2-fill-title">Цвет строки</div>
+          <div className="p2-fill-swatches" role="radiogroup" aria-label="Цвет">
+            {BAND_FILLS.map((f) => (
+              <button key={f.id} type="button" role="radio" aria-checked={f.id === fill.id} aria-label={f.label} title={f.label}
+                className={`p2-fill-sw${f.id === fill.id ? " is-on" : ""}${f.color ? "" : " p2-fill-sw--none"}`} style={f.color ? { "--sw": f.color } : undefined}
+                onClick={() => onChange({ id: f.id, where })} />
+            ))}
+          </div>
+          <div className="p2-fill-title">Где</div>
+          <div className="p2-fill-where" role="radiogroup" aria-label="Где заливать">
+            {WHERE.map(({ id, label, Icon }) => (
+              <button key={id} type="button" role="radio" aria-checked={id === where} disabled={!fill.color} className={`p2-fill-opt${id === where ? " is-on" : ""}`} onClick={() => onChange({ id: fill.id, where: id })}>
+                <Icon /><span>{label}</span>
+              </button>
+            ))}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
