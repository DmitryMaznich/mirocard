# Token from @BotFather for the dedicated Mirocard feedback bot (NOT Kaplieva_bot).
FEEDBACK_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram user id of the owner — only this user's pin reactions are captured.
FEEDBACK_BOT_OWNER_ID=468130718

# Telegram chat id of the testers group (negative number, e.g. -1001234567890).
FEEDBACK_BOT_CHAT_ID=-1001234567890

# Days to keep cached messages so a reaction can still resolve after a restart.
FEEDBACK_BOT_CACHE_RETENTION_DAYS=30

# Where inbox.jsonl, screenshots/, and message_cache.json are written.
FEEDBACK_BOT_DATA_DIR=C:/Users/dmazn/Projects/Mirocard2/feedback

# --- Video ingestion (optional) ---
# Leave everything below unset to keep the bot feedback-only.

# Local Bot API server URL. The standard Bot API caps file downloads at
# 20 MB, too small for phone-shot video. A telegram-bot-api server run
# alongside this bot (see docs/feedback-bot-setup.md) raises that to 2 GB.
TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081

# Chat id of the separate video-archive group (bot must be a member there).
# Leave unset to disable video ingestion entirely.
FEEDBACK_BOT_VIDEO_CHAT_ID=-1009876543210

# Google Photos OAuth client (Desktop app type), downloaded as JSON from
# Google Cloud Console after enabling the Photos Library API. Kept under
# FEEDBACK_BOT_DATA_DIR (already gitignored) rather than feedback-bot/,
# so it can't accidentally get committed as source.
GOOGLE_PHOTOS_CLIENT_SECRET_PATH=C:/Users/dmazn/Projects/Mirocard2/feedback/google_client_secret.json

# Where the saved OAuth refresh token lives after the one-time
# authorize_google_photos.py run.
GOOGLE_PHOTOS_TOKEN_PATH=C:/Users/dmazn/Projects/Mirocard2/feedback/google_photos_token.json

# Id of the shared album videos get uploaded into. Left blank until
# authorize_google_photos.py creates the album and prints it.
GOOGLE_PHOTOS_ALBUM_ID=

# Title used only the first time authorize_google_photos.py creates the
# album (ignored once GOOGLE_PHOTOS_ALBUM_ID is set).
GOOGLE_PHOTOS_ALBUM_TITLE=Video Archive
