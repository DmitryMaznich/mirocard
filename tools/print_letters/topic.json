          "default": "trace",
          "ordered": true
        },
        "width": {
          "type": "enum",
          "label": { "ru": "Ширина дорожки" },
          "values": ["wide", "mid", "narrow"],
          "labels": {
            "ru": { "wide": "Широкая", "mid": "Средняя", "narrow": "Узкая" }
          },
          "default": "wide",
          "ordered": true,
          "showWhen": { "level": "trace" }
        },
        "copies": {
          "type": "enum",
          "label": { "ru": "Сколько раз каждую букву" },
          "values": [1, 3, 5],
          "labels": {
            "ru": { "1": "1", "3": "3", "5": "5" }
          },
          "default": 3
        },
        "sound": {
          "type": "boolean",
          "default": true,
          "label": { "ru": "Тихий звук на каждый штрих" }
        }
      }
    }
