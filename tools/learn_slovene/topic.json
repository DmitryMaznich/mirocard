            "mix"
          ],
          "labels": {
            "ru": {
              "sl_ru": "S → С",
              "ru_sl": "С → S",
              "mix": "Вперемешку"
            }
          },
          "default": "sl_ru",
          "hint": {
            "ru": "S → С: видна словенская буква, выбрать русскую. С → S — наоборот."
          }
        }
      }
    },
    {
      "id": "lb_trap",
