            6
          ],
          "labels": {
            "ru": {
              "3": "3",
              "4": "4",
              "6": "6"
            }
          },
          "default": 3
        },
        "check": {
          "type": "enum",
          "label": {
            "ru": "Проверка после знакомства"
          },
          "values": [
            "on",
            "off"
          ],
          "labels": {
            "ru": {
              "on": "Да",
              "off": "Только знакомство"
            }
          },
          "default": "on"
        }
      }
    },
