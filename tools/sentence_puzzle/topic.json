        "structure": {
          "type": "enum",
          "label": { "ru": "Структура" },
          "values": ["simple", "full"],
          "labels": { "ru": { "simple": "Простая (кто + что делает)", "full": "Полная (кто + что делает + какую + что)" } },
          "default": "simple"
        }
      }
    },
    {
      "id": "listen_build",
      "type": "listen_build",
      "evaluation": "auto",
