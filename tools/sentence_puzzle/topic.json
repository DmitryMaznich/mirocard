      "params": {
        "structure": {
          "type": "enum",
          "label": { "ru": "Структура" },
          "values": ["simple", "full"],
          "labels": { "ru": { "simple": "Простая (кто + что делает)", "full": "Полная (кто + что делает + какую + что)" } },
          "default": "simple"
        },
        "distractors": {
          "type": "enum",
          "label": { "ru": "Дистракторов" },
          "values": [1, 2, 3],
          "labels": { "ru": { "1": "1×4", "2": "2×4", "3": "3×4" } },
          "default": 2
        }
      }
