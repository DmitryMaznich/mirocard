        "title": "Собираем пазл",
        "instruction": "Собери предложения из слов",
        "icon": "media/icons/sentence_puzzle_mode.svg"
      },
      "params": {
        "level": {
          "type": "enum",
          "label": { "ru": "Сложность" },
          "values": [1, 2, 3],
          "labels": { "ru": { "1": "1 предложение", "2": "2 предложения", "3": "3 предложения" } },
          "default": 1
        },
        "structure": {
          "type": "enum",
          "label": { "ru": "Структура" },
          "values": ["simple", "full"],
          "labels": { "ru": { "simple": "Простая (кто + что делает)", "full": "Полная (кто + что делает + какую + что)" } },
          "default": "simple"
        }
      }
    },
    {
      "id": "listen_build_mono",
      "type": "listen_build_mono",
      "evaluation": "auto",
      "ui": {
        "title": "Слушаем и составляем",
