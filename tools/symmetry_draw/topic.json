{
  "meta": {
    "id": "symmetry_draw",
    "version": "1.3.1",
    "renderer": "flashcards",
    "customModesOnly": true,
    "title": "Рисуем по клеткам",
    "avatar": "media/avatar.svg",
    "about": {
      "description": "Ребёнок дорисовывает вторую половину фигуры на клетчатом поле, соблюдая симметрию относительно вертикальной оси.",
      "goals": [
        "Развивать зрительно-пространственное восприятие и представление симметрии.",
        "Закреплять формы: квадрат, треугольник, круг, овал и ромб."
      ],
      "finalGoal": "Ребёнок самостоятельно дорисовывает симметричную фигуру по клеточкам без подсказок."
    }
  },
  "modes": [
    {
      "id": "symmetry_draw",
      "type": "mirror_draw",
      "evaluation": "auto",
      "ui": {
        "title": "Симметричный рисунок",
        "instruction": "Дорисуй вторую половину фигуры",
        "icon": "media/avatar.svg"
      }
    },
    {
      "id": "repeat_draw",
      "type": "repeat_draw",
      "evaluation": "auto",
      "ui": {
        "title": "Повтори рисунок",
        "instruction": "Повтори рисунок целиком справа",
        "icon": "media/repeat_avatar.svg"
      }
    },
    {
      "id": "graphic_dictation",
      "type": "graphic_dictation",
